{
  "$schema": "../../schemas/object.schema.json",
  "entries": [
    {
      "id": "obj_door",
      "name": "Door",
      "description": "A sliding pressure door. It opens with a tool, such as a cutter, and prying it open wears the tool a little. A heavy suit can force it, but it won't fit through: the frame only takes someone of person size. Close it behind you if you like.",
      "glyph": "◆",
      "size": 3,
      "holds_size": 3,
      "states": [
        "state_closed",
        "state_open"
      ],
      "state_glyphs": {
        "state_open": "◇"
      },
      "interactions": [
        {
          "id": "open",
          "label": "Open",
          "key": "u",
          "shown_if": {
            "check": "object_state",
            "object": "this",
            "state": "state_closed"
          },
          "requires": {
            "any": [
              {
                "check": "has_tag",
                "tag": "tag_tool"
              },
              {
                "check": "size",
                "min": 5
              }
            ]
          },
          "hint": "Needs a tool or a heavy suit.",
          "effects": [
            {
              "op": "set_state",
              "object": "this",
              "state": "state_open"
            },
            {
              "op": "wear",
              "pick": {
                "used": true
              },
              "amount": 1
            }
          ]
        },
        {
          "id": "close",
          "label": "Close",
          "key": "u",
          "shown_if": {
            "check": "object_state",
            "object": "this",
            "state": "state_open"
          },
          "effects": [
            {
              "op": "set_state",
              "object": "this",
              "state": "state_closed"
            }
          ]
        }
      ]
    },
    {
      "id": "obj_passage",
      "name": "Passage",
      "glyph": "◆",
      "holds_size": 5
    },
    {
      "id": "obj_crate",
      "name": "Crate",
      "description": "A battered supply crate, restocked every morning. Searching it takes two turns and works once a day. Half the time there's something inside: scrap, a medkit, now and then a spare part.",
      "glyph": "⊞",
      "size": 2,
      "holds_size": 1,
      "solid": true,
      "states": [
        "state_closed",
        "state_used"
      ],
      "interactions": [
        {
          "id": "search",
          "label": "Search",
          "key": "h",
          "repeat": "daily",
          "time": 2,
          "requires": {
            "check": "object_state",
            "object": "this",
            "state": "state_closed"
          },
          "hint": "Already searched.",
          "effects": [
            {
              "op": "set_state",
              "object": "this",
              "state": "state_used"
            },
            {
              "op": "if",
              "if": {
                "check": "chance",
                "p": 0.5
              },
              "then": [
                {
                  "op": "roll_loot",
                  "table": "loot_crate"
                },
                {
                  "op": "set_flag",
                  "flag": "flag_power",
                  "add": 1
                },
                {
                  "op": "message",
                  "text": "You find something.",
                  "kind": "gain"
                }
              ],
              "else": [
                {
                  "op": "message",
                  "text": "Empty."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "obj_terminal",
      "name": "Terminal",
      "description": "A maintenance terminal wired into the station. Checking the logs keeps the crew informed, and they think a little better of you for it. Rerouting power needs the power on, and uses it up until something brings it back.",
      "glyph": "⌸",
      "colour": "green",
      "solid": true,
      "interactions": [
        {
          "id": "use",
          "label": "Use",
          "key": "r",
          "effects": [
            {
              "op": "choose",
              "prompt": "The screen wakes.",
              "options": [
                {
                  "label": "Check the logs",
                  "effects": [
                    {
                      "op": "change_relation",
                      "of": {
                        "faction": "faction_crew"
                      },
                      "amount": 5
                    }
                  ]
                },
                {
                  "label": "Reroute power",
                  "condition": {
                    "check": "flag",
                    "flag": "flag_power",
                    "min": 1
                  },
                  "hint": "Needs the power on.",
                  "effects": [
                    {
                      "op": "set_flag",
                      "flag": "flag_power",
                      "value": 0
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "obj_locker",
      "name": "Locker",
      "description": "A steel locker with room for six stacks of anything up to medium size: tools, materials, spares. Suits don't fit. Stand next to it and use the pack to store or take items, a whole stack at a time.",
      "glyph": "▯",
      "size": 3,
      "holds_size": 2,
      "storage": 6,
      "solid": true
    },
    {
      "id": "obj_bench",
      "name": "Workbench",
      "description": "A proper workbench: vice, cutters, a small furnace. Stand next to it and use the gear screen to put on or take off suits, tools and implants; repair worn gear with scrap; take items apart for materials, and learn how they're made if your Salvage is good enough; make items you know the design of; and modify gear, which fills one of its mod slots for good. It only works on common-grade gear.",
      "glyph": "■",
      "solid": true,
      "workshop": {
        "services": [
          "equip",
          "dismantle",
          "make",
          "modify",
          "repair"
        ],
        "max_grade": "grade_common"
      }
    },
    {
      "id": "obj_bay",
      "name": "Suit bay",
      "description": "A suit rack with clamps and power lines, big enough for a heavy suit. It stores six stacks, suits included. Stand next to it and use the gear screen to put on or take off suits, tools and implants. It can't repair or make anything.",
      "glyph": "▣",
      "solid": true,
      "size": 5,
      "holds_size": 5,
      "storage": 6,
      "workshop": {
        "services": [
          "equip"
        ]
      }
    },
    {
      "id": "obj_hatch",
      "name": "Floor hatch",
      "description": "A maintenance hatch over the crawlspace. Drones have nested down there. Opening it brings them up for a fight, so be ready before you do.",
      "glyph": "⊙",
      "solid": true,
      "interactions": [
        {
          "id": "open",
          "label": "Open",
          "key": "u",
          "effects": [
            {
              "op": "start_encounter",
              "encounter": "enc_drones"
            }
          ]
        }
      ]
    },
    {
      "id": "obj_trainer",
      "name": "Training sim",
      "description": "Test only: a training rig. Each use gives 30 Salvage experience, so the higher Salvage levels (Burn at level 2) are quick to reach by hand.",
      "glyph": "§",
      "solid": true,
      "interactions": [
        {
          "id": "train",
          "label": "Train Salvage",
          "key": "u",
          "effects": [
            {
              "op": "grant_xp",
              "skill": "skill_salvage",
              "amount": 30
            }
          ]
        }
      ]
    },
    {
      "id": "obj_medbay",
      "name": "Med station",
      "description": "Test only: an automatic medical bay. Using it heals everyone in your party in full, and gets anyone who went down back on their feet.",
      "glyph": "+",
      "solid": true,
      "interactions": [
        {
          "id": "heal",
          "label": "Heal the party",
          "key": "u",
          "effects": [
            {
              "op": "restore",
              "stat": "stat_health",
              "amount": 99,
              "subject": "party"
            },
            {
              "op": "message",
              "text": "Everyone is patched up.",
              "kind": "gain"
            }
          ]
        }
      ]
    },
    {
      "id": "obj_ground",
      "name": "Open ground",
      "description": "Open ground that runs on into the next area. Step onto it to go on.",
      "glyph": "·",
      "holds_size": 5
    }
  ]
}
