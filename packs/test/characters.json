{
  "$schema": "../../schemas/character.schema.json",
  "entries": [
    {
      "id": "char_player",
      "name": "Player",
      "body": {
        "size": 3,
        "stats": {
          "stat_health": 10,
          "stat_cargo": 2
        },
        "slots": [
          {
            "slot_type": "slot_body_a"
          }
        ]
      },
      "frame": "frame_a",
      "fitted": [
        "module_tool",
        "module_system"
      ],
      "inventory": [
        {
          "item": "consumable_a",
          "count": 3
        },
        {
          "item": "material_a",
          "count": 12
        },
        {
          "item": "misc_key",
          "count": 1
        }
      ],
      "skills": {
        "skill_a": 1
      },
      "on_defeat": [
        {
          "op": "message",
          "text": "You go down.",
          "kind": "danger"
        },
        {
          "op": "move_to",
          "location": "room_a",
          "entry": "pl_a_crate"
        },
        {
          "op": "restore",
          "stat": "stat_health",
          "amount": 5
        },
        {
          "op": "trigger_event",
          "event": "event_rescue"
        }
      ],
      "designs": []
    },
    {
      "id": "char_npc",
      "name": "Npc",
      "title": "Test NPC",
      "faction": "faction_a",
      "location": "room_a",
      "at": [
        3,
        3
      ],
      "body": {
        "size": 3,
        "stats": {
          "stat_health": 10,
          "stat_cargo": 2
        },
        "slots": [
          {
            "slot_type": "slot_body_a"
          }
        ]
      },
      "implants": [
        "implant_a"
      ],
      "wants": [
        "tag_a"
      ],
      "views": [
        {
          "toward": "player",
          "value": 10
        },
        {
          "toward": {
            "faction": "faction_a"
          },
          "value": 50
        }
      ],
      "talk": [
        {
          "when": {
            "check": "in_party"
          },
          "text": "Lead on."
        },
        {
          "when": {
            "check": "relation",
            "of": "self",
            "toward": "target",
            "min": 50
          },
          "text": "Good to see you."
        },
        {
          "text": "@greeting"
        }
      ],
      "interactions": [
        {
          "id": "trade",
          "label": "Trade",
          "key": "b",
          "repeat": "once",
          "requires": {
            "check": "has_item",
            "item": "misc_key"
          },
          "hint": "Wants a key.",
          "effects": [
            {
              "op": "take_item",
              "item": "misc_key"
            },
            {
              "op": "give_item",
              "item": "consumable_a",
              "count": 2
            },
            {
              "op": "change_relation",
              "of": "target",
              "toward": "self",
              "amount": 20
            }
          ]
        },
        {
          "id": "recruit",
          "label": "Recruit",
          "key": "t",
          "shown_if": {
            "not": {
              "check": "in_party",
              "subject": "target"
            }
          },
          "requires": {
            "check": "relation",
            "of": "target",
            "toward": "self",
            "min": 25
          },
          "hint": "Doesn't trust you enough.",
          "effects": [
            {
              "op": "join_party",
              "subject": "target",
              "leader": "self"
            }
          ]
        }
      ]
    },
    {
      "id": "char_drone",
      "name": "Drone",
      "template": true,
      "glyph": "d",
      "tags": [
        "tag_hazard"
      ],
      "art": [
        "  ┌─┬─┐  ",
        "══╡▓▓▓╞══",
        "  └┬─┬┘  "
      ],
      "body": {
        "size": 2,
        "stats": {
          "stat_health": 8,
          "stat_initiative": 2,
          "stat_power": 6
        }
      },
      "actions": [
        "action_strike"
      ],
      "ai": {
        "flee_below": 0.25
      },
      "loot": "loot_drone"
    }
  ]
}
