{
  "$schema": "../../schemas/character.schema.json",
  "entries": [
    {
      "id": "char_player",
      "name": "Player",
      "art": "art_player",
      "body": {
        "size": 3,
        "stats": {
          "stat_health": 10,
          "stat_cargo": 2
        },
        "slots": [
          {
            "slot_type": "slot_head"
          }
        ]
      },
      "frame": "frame_light",
      "fitted": [
        "module_cutter",
        "module_shield"
      ],
      "inventory": [
        {
          "item": "consumable_medkit",
          "count": 3
        },
        {
          "item": "material_scrap",
          "count": 12
        },
        {
          "item": "misc_keycard",
          "count": 1
        }
      ],
      "skills": {
        "skill_salvage": 1
      },
      "on_defeat": [
        {
          "op": "message",
          "text": "You go down.",
          "kind": "danger"
        },
        {
          "op": "move_to",
          "location": "loc_workshop",
          "entry": "workshop_crate"
        },
        {
          "op": "restore",
          "stat": "stat_health",
          "amount": 5
        },
        {
          "op": "trigger_event",
          "event": "event_rescue"
        }
      ],
      "designs": []
    },
    {
      "id": "char_juno",
      "name": "Juno",
      "title": "Scrap trader",
      "description": "Deals in whatever the station throws away. Juno will trade two medkits for a keycard, once, and trusts you more after a fair deal. Once Juno trusts you, Juno will join you, fight beside you and follow you from room to room.",
      "art": "art_juno",
      "faction": "faction_crew",
      "location": "loc_workshop",
      "at": [
        3,
        3
      ],
      "body": {
        "size": 3,
        "stats": {
          "stat_health": 10,
          "stat_cargo": 2
        },
        "slots": [
          {
            "slot_type": "slot_head"
          }
        ]
      },
      "implants": [
        "implant_eye"
      ],
      "wants": [
        "tag_tool"
      ],
      "views": [
        {
          "toward": "player",
          "value": 10
        },
        {
          "toward": {
            "faction": "faction_crew"
          },
          "value": 50
        }
      ],
      "talk": [
        {
          "when": {
            "check": "in_party"
          },
          "text": "Lead on."
        },
        {
          "when": {
            "check": "relation",
            "of": "self",
            "toward": "target",
            "min": 50
          },
          "text": "Good to see you."
        },
        {
          "text": "@str_greeting"
        }
      ],
      "interactions": [
        {
          "id": "trade",
          "label": "Trade",
          "key": "b",
          "repeat": "once",
          "requires": {
            "check": "has_item",
            "item": "misc_keycard"
          },
          "hint": "Wants a keycard.",
          "effects": [
            {
              "op": "take_item",
              "item": "misc_keycard"
            },
            {
              "op": "give_item",
              "item": "consumable_medkit",
              "count": 2
            },
            {
              "op": "change_relation",
              "of": "target",
              "toward": "self",
              "amount": 20
            }
          ]
        },
        {
          "id": "recruit",
          "label": "Recruit",
          "key": "t",
          "shown_if": {
            "not": {
              "check": "in_party",
              "subject": "target"
            }
          },
          "requires": {
            "check": "relation",
            "of": "target",
            "toward": "self",
            "min": 25
          },
          "hint": "Doesn't trust you enough.",
          "effects": [
            {
              "op": "join_party",
              "subject": "target",
              "leader": "self"
            }
          ]
        }
      ]
    },
    {
      "id": "char_drone",
      "name": "Drone",
      "template": true,
      "glyph": "d",
      "tags": [
        "tag_machine"
      ],
      "art": "art_drone",
      "body": {
        "size": 2,
        "stats": {
          "stat_health": 8,
          "stat_initiative": 2,
          "stat_power": 6
        }
      },
      "actions": [
        "action_strike"
      ],
      "ai": {
        "flee_below": 0.25
      },
      "loot": "loot_drone"
    },
    {
      "id": "char_dov",
      "name": "Dov",
      "rank": 1,
      "faction": "faction_crew",
      "body": {
        "size": 3,
