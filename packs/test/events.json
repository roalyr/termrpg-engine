{
  "$schema": "../../schemas/event.schema.json",
  "entries": [
    {
      "id": "event_grudge",
      "name": "Grudge",
      "trigger": "day_start",
      "chance": 0.3,
      "cooldown": 3,
      "cast": [
        {
          "role": "sore",
          "from": "anyone",
          "when": {
            "check": "relation",
            "of": "self",
            "toward": "player",
            "max": -20
          }
        },
        {
          "role": "friend",
          "from": "here",
          "optional": true,
          "when": {
            "check": "relation",
            "of": "self",
            "toward": {
              "role": "sore"
            },
            "min": 30
          }
        }
      ],
      "text": "Someone holds a grudge.",
      "effects": [
        {
          "op": "change_relation",
          "of": {
            "role": "friend"
          },
          "toward": "player",
          "amount": -5
        },
        {
          "op": "choose",
          "prompt": "What do you do?",
          "options": [
            {
              "label": "Apologise",
              "effects": [
                {
                  "op": "change_relation",
                  "of": {
                    "role": "sore"
                  },
                  "amount": 10
                }
              ]
            },
            {
              "label": "Ignore it",
              "effects": [
                {
                  "op": "message",
                  "text": "@str_shrug"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "event_offscreen",
      "name": "Off-screen rivalry",
      "trigger": "day_start",
      "notify": false,
      "cast": [
        {
          "role": "a",
          "when": {
            "check": "rank",
            "min": 1
          }
        },
        {
          "role": "b",
          "when": {
            "all": [
              {
                "check": "rank",
                "min": 1
              },
              {
                "check": "relation",
                "of": "self",
                "toward": {
                  "role": "a"
                },
                "max": 0
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "op": "change_relation",
          "of": {
            "role": "a"
          },
          "toward": {
            "role": "b"
          },
          "amount": -10,
          "mutual": true
        },
        {
          "op": "change_rank",
          "amount": 1,
          "subject": {
            "role": "a"
          }
        }
      ]
    },
    {
      "id": "event_rescue",
      "name": "Rescue",
      "trigger": "manual",
      "effects": [
        {
          "op": "message",
          "text": "Someone drags you out.",
          "kind": "danger"
        }
      ]
    },
    {
      "id": "event_insight",
      "name": "Insight",
      "trigger": "manual",
      "when": {
        "not": {
          "check": "knows_design",
          "item": "module_shield"
        }
      },
      "effects": [
        {
          "op": "learn_design",
          "item": "module_shield"
        },
        {
          "op": "modify_item",
          "pick": {
            "slot_type": "slot_back"
          },
          "stats": {
            "stat_armor": 1
          },
          "name_suffix": "Tuned"
        }
      ]
    },
    {
      "id": "event_restock",
      "name": "Restock",
      "trigger": "day_start",
      "notify": false,
      "effects": [
        {
          "op": "set_state",
          "object": "workshop_crate",
          "state": "state_closed"
        }
      ]
    },
    {
      "id": "event_rest",
      "name": "Rest",
      "trigger": "day_start",
      "notify": false,
      "notes": "A night's rest: everyone in the player's party gets some health back each morning, and someone who went down gets up again.",
      "effects": [
        {
          "op": "restore",
          "stat": "stat_health",
          "amount": 10,
          "subject": "party"
        }
      ]
    },
    {
      "id": "event_arrival",
      "name": "Arrival",
      "trigger": "enter_location",
      "when": {
        "check": "location",
        "location": "loc_storage"
      },
      "text": "Machines hum somewhere below.",
      "effects": [
        {
          "op": "set_flag",
          "flag": "flag_power",
          "add": 1
        }
      ]
    },
    {
      "id": "event_once",
      "name": "Once",
      "trigger": "manual",
      "repeat": false,
      "effects": [
        {
          "op": "set_flag",
          "flag": "flag_power",
          "add": 10
        }
      ]
    }
  ]
}
