{
  "$schema": "../../../schemas/ui.schema.json",
  "size": {
    "min_columns": 40,
    "min_rows": 20,
    "cell_width": 2,
    "tile_width": 10,
    "bar_length": 8,
    "fighter_bar_length": 6,
    "side_min_width": 14,
    "page_size": 9
  },
  "padding": 1,
  "glyphs": {
    "border": {
      "horizontal": "─",
      "vertical": "│",
      "top_left": "┌",
      "top_right": "┐",
      "bottom_left": "└",
      "bottom_right": "┘",
      "join_left": "├",
      "join_right": "┤"
    },
    "bar_full": "█",
    "bar_empty": "░",
    "player": "@",
    "intent": "⚠",
    "cost": "▲",
    "mark_danger": "! ",
    "mark_gain": "+ ",
    "separator": " · "
  },
  "styles": {
    "title": {
      "colour": "white",
      "bold": true
    },
    "heading": {
      "colour": "white",
      "bold": true
    },
    "danger": {
      "colour": "orange"
    },
    "gain": {
      "colour": "white",
      "bold": true
    },
    "quiet": {
      "colour": "grey",
      "dim": true
    },
    "unavailable": {
      "colour": "grey",
      "dim": true
    },
    "hint": {
      "colour": "grey",
      "dim": true
    },
    "key": {
      "colour": "white"
    }
  }
}
