{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "item.schema.json",
  "title": "Items (items.json)",
  "description": "Everything that can be carried, fitted or implanted. Every item has a 'kind' that decides its extra fields: frame (a suit), module (fitted into frame slots; gear is a module in a limb or hand slot), implant, material, consumable, misc.",
  "x-schema-version": 2,
  "$ref": "#/$defs/items_file",
  "$defs": {
    "items_file": {
      "type": "object",
      "description": "A file of items.",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "Path to this file's schema, for editors. Ignored by the engine."
        },
        "entries": {
          "type": "array",
          "description": "Entries.",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "entries"
      ]
    },
    "item": {
      "description": "One item. 'kind' picks the fields.",
      "x-discriminator": "kind",
      "oneOf": [
        {
          "$ref": "#/$defs/frame"
        },
        {
          "$ref": "#/$defs/module"
        },
        {
          "$ref": "#/$defs/implant"
        },
        {
          "$ref": "#/$defs/material"
        },
        {
          "$ref": "#/$defs/consumable"
        },
        {
          "$ref": "#/$defs/misc"
        }
      ]
    },
    "budget": {
      "type": "object",
      "description": "How much of the frame's budgets this uses while fitted. Power and mass must fit within what the frame and other gear provide; heat is a constant load that lowers how much heat can build up before overheating.",
      "properties": {
        "power": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "mass": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "heat": {
          "type": "number",
          "minimum": 0,
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "description": "A suit or piloted machine: the body a character works in. Its stats set the budgets modules draw on.",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/label"
        },
        "description": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "size": {
          "$ref": "common.schema.json#/$defs/size",
          "description": "How big it is: whether it fits into containers, holds and hatches. For a frame, also the size of whoever wears it."
        },
        "holds_size": {
          "$ref": "common.schema.json#/$defs/size",
          "description": "Largest size class that fits in or onto it, for items that hold things (a bag, a cargo module). Without it nothing fits."
        },
        "grade": {
          "$ref": "common.schema.json#/$defs/id",
          "x-ref": "grade",
          "description": "Quality or strangeness tier, shown as the item's colour."
        },
        "tags": {
          "$ref": "common.schema.json#/$defs/tags",
          "description": "Count for has_tag checks while carried, fitted or implanted (see the check's 'source')."
        },
        "stats": {
          "type": "object",
          "description": "Stat id to amount this adds to its holder while it is active (a frame worn, a module fitted, an implant implanted). A frame's stats also provide the budgets: power, mass, heat and cargo.",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "additionalProperties": {
            "type": "number"
          },
          "x-ref-keys": "stat"
        },
        "actions": {
          "type": "array",
          "description": "Actions it gives its holder in encounters while active.",
          "items": {
            "$ref": "common.schema.json#/$defs/id",
            "x-ref": "action"
          },
          "uniqueItems": true
        },
        "interactions": {
          "type": "array",
          "description": "What its holder can do with it from the pack. 'self' is the holder; the item pick {'used': true} is this item.",
          "items": {
            "$ref": "common.schema.json#/$defs/interaction"
          }
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "description": "Rough trade value."
        },
        "stack": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "How many fit in one cargo stack."
        },
        "condition": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum condition. Items with a condition wear down and break at 0; items without one never wear."
        },
        "salvage": {
          "type": "object",
          "description": "What dismantling it at a workshop gives. Dismantling destroys the item.",
          "properties": {
            "yields": {
              "type": "array",
              "description": "A list of items with counts. Results are always the same: no rolls.",
              "items": {
                "type": "object",
                "description": "Items and how many.",
                "properties": {
                  "item": {
                    "$ref": "common.schema.json#/$defs/id",
                    "x-ref": "item"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item"
                ]
              },
              "minItems": 1
            },
            "learn": {
              "type": "boolean",
              "default": true,
              "description": "Dismantling can teach its design."
            },
            "learn_requires": {
              "$ref": "common.schema.json#/$defs/condition",
              "description": "Needed to learn the design, e.g. a skill level. Without it you still get the materials."
            }
          },
          "additionalProperties": false,
          "required": [
            "yields"
          ]
        },
        "fabricate": {
          "type": "object",
          "description": "What making a copy costs at a workshop. Needs the design.",
          "properties": {
            "inputs": {
              "type": "array",
              "description": "A list of items with counts. Results are always the same: no rolls.",
              "items": {
                "type": "object",
                "description": "Items and how many.",
                "properties": {
                  "item": {
                    "$ref": "common.schema.json#/$defs/id",
                    "x-ref": "item"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item"
                ]
              },
              "minItems": 1
            },
            "requires": {
              "$ref": "common.schema.json#/$defs/condition",
              "description": "Needed besides knowing the design, e.g. a skill level."
            },
            "time": {
              "type": "integer",
              "minimum": 0,
              "default": 1,
              "description": "Turns it takes."
            }
          },
          "additionalProperties": false,
          "required": [
            "inputs"
          ]
        },
        "repair": {
          "type": "object",
          "description": "What restoring its condition costs at a workshop. Only for items with a condition.",
          "properties": {
            "inputs": {
              "type": "array",
              "description": "A list of items with counts. Results are always the same: no rolls.",
              "items": {
                "type": "object",
                "description": "Items and how many.",
                "properties": {
                  "item": {
                    "$ref": "common.schema.json#/$defs/id",
                    "x-ref": "item"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item"
                ]
              },
              "minItems": 1
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "description": "Condition restored per repair. Fully repaired if left out."
            }
          },
          "additionalProperties": false,
          "required": [
            "inputs"
          ]
        },
        "notes": {
          "$ref": "common.schema.json#/$defs/notes"
        },
        "kind": {
          "const": "frame"
        },
        "slots": {
          "type": "array",
          "description": "The slots modules are fitted into.",
          "items": {
            "type": "object",
            "description": "Slots of one type.",
            "properties": {
              "slot_type": {
                "$ref": "common.schema.json#/$defs/id",
                "x-ref": "slot_type",
                "description": "Must be a frame slot type."
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "default": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "slot_type"
            ]
          },
          "minItems": 1
        },
        "mod_slots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0,
          "description": "How many modifications it can take. Modifications are permanent."
        },
        "fit_requires": {
          "$ref": "common.schema.json#/$defs/condition",
          "description": "Who can fit, wear or implant it, e.g. a skill level. Checked with 'self' as the character."
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "size",
        "slots"
      ]
    },
    "module": {
      "type": "object",
      "description": "Anything fitted into a frame slot: tools and weapons in limb or hand slots, systems in others.",
      "properties": {
