{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "item.schema.json",
  "title": "Items (items.json)",
  "description": "Everything that can be carried or equipped. Every item has a 'kind' that decides its extra fields: gear (equipped in a slot: armour, suits, tools, weapons, implants), material, consumable, misc.",
  "x-schema-version": 4,
  "$ref": "#/$defs/items_file",
  "$defs": {
    "items_file": {
      "type": "object",
      "description": "A file of items.",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "Path to this file's schema, for editors. Ignored by the engine."
        },
        "entries": {
          "type": "array",
          "description": "Entries.",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "entries"
      ]
    },
    "item": {
      "description": "One item. 'kind' picks the fields.",
      "x-discriminator": "kind",
      "oneOf": [
        {
          "$ref": "#/$defs/gear"
        },
        {
          "$ref": "#/$defs/material"
        },
        {
          "$ref": "#/$defs/consumable"
        },
        {
          "$ref": "#/$defs/misc"
        }
      ]
    },
    "gear": {
      "type": "object",
      "description": "Anything equipped in a slot: armour and suits in a worn slot, tools and weapons in hands, implants and blessings in body slots. Slots come from the body and from other gear.",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/label"
        },
        "description": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "size": {
          "$ref": "common.schema.json#/$defs/size",
          "description": "How big it is: whether it fits into containers, holds and doors."
        },
        "holds_size": {
          "$ref": "common.schema.json#/$defs/size",
          "description": "Largest size class that fits in or onto it, for items that hold things (a bag, a cargo rack). Without it nothing fits."
        },
        "grade": {
          "$ref": "common.schema.json#/$defs/id",
          "x-ref": "grade",
          "description": "Quality or strangeness tier, shown as the item's colour."
        },
        "tags": {
          "$ref": "common.schema.json#/$defs/tags",
          "description": "Count for has_tag checks while carried or equipped (see the check's 'source')."
        },
        "stats": {
          "type": "object",
          "description": "Stat id to amount this adds to its holder while it is equipped. Budget stats added here are what gear can use.",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "additionalProperties": {
            "type": "number"
          },
          "x-ref-keys": "stat"
        },
        "actions": {
          "type": "array",
          "description": "Actions it gives its holder in encounters while active.",
          "items": {
            "$ref": "common.schema.json#/$defs/id",
            "x-ref": "action"
          },
          "uniqueItems": true
        },
        "interactions": {
          "type": "array",
          "description": "What its holder can do with it from the pack. 'self' is the holder; the item pick {'used': true} is this item.",
          "items": {
            "$ref": "common.schema.json#/$defs/interaction"
          }
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "description": "Rough trade value."
        },
        "stack": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "How many fit in one cargo stack."
        },
        "condition": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum condition. Items with a condition wear down and break at 0; items without one never wear."
        },
        "dismantle": {
          "type": "object",
          "description": "What dismantling it at a workshop gives. Dismantling destroys the item.",
          "properties": {
            "yields": {
              "type": "array",
              "description": "A list of items with counts. Results are always the same: no rolls.",
              "items": {
                "type": "object",
                "description": "Items and how many.",
                "properties": {
                  "item": {
                    "$ref": "common.schema.json#/$defs/id",
                    "x-ref": "item"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item"
                ]
              },
              "minItems": 1
            },
            "learn": {
              "type": "boolean",
              "default": true,
              "description": "Dismantling can teach its design."
            },
            "learn_requires": {
              "$ref": "common.schema.json#/$defs/condition",
              "description": "Needed to learn the design, e.g. a skill level. Without it you still get the materials."
            }
          },
          "additionalProperties": false,
          "required": [
            "yields"
          ]
        },
        "make": {
          "type": "object",
          "description": "What making a copy costs at a workshop. Needs the design.",
          "properties": {
            "inputs": {
              "type": "array",
              "description": "A list of items with counts. Results are always the same: no rolls.",
              "items": {
                "type": "object",
                "description": "Items and how many.",
                "properties": {
                  "item": {
                    "$ref": "common.schema.json#/$defs/id",
                    "x-ref": "item"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item"
                ]
              },
              "minItems": 1
            },
            "requires": {
              "$ref": "common.schema.json#/$defs/condition",
              "description": "Needed besides knowing the design, e.g. a skill level."
            },
            "time": {
              "type": "integer",
              "minimum": 0,
              "default": 1,
              "description": "Turns it takes."
            }
          },
          "additionalProperties": false,
          "required": [
            "inputs"
          ]
        },
        "repair": {
          "type": "object",
          "description": "What restoring its condition costs at a workshop. Only for items with a condition.",
          "properties": {
            "inputs": {
              "type": "array",
              "description": "A list of items with counts. Results are always the same: no rolls.",
              "items": {
                "type": "object",
                "description": "Items and how many.",
                "properties": {
                  "item": {
                    "$ref": "common.schema.json#/$defs/id",
                    "x-ref": "item"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item"
                ]
              },
              "minItems": 1
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "description": "Condition restored per repair. Fully repaired if left out."
            }
          },
          "additionalProperties": false,
          "required": [
            "inputs"
          ]
        },
        "notes": {
          "$ref": "common.schema.json#/$defs/notes"
        },
        "kind": {
          "const": "gear"
        },
        "slot_type": {
          "$ref": "common.schema.json#/$defs/id",
          "x-ref": "slot_type",
          "description": "The slot it is equipped in."
        },
        "uses": {
          "type": "object",
          "description": "Budget stat id to how much of it this uses while equipped, e.g. power or weight. On a filling pool (heat) it is a constant load: the pool's resting value.",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          },
          "x-ref-keys": "stat"
        },
        "slots": {
          "type": "array",
          "description": "Slots it adds while equipped, e.g. a suit's hand slots or a belt's pouches. It can't be taken off while something is in them.",
          "items": {
            "type": "object",
            "description": "Slots of one type.",
            "properties": {
              "slot_type": {
                "$ref": "common.schema.json#/$defs/id",
                "x-ref": "slot_type",
                "description": "Not its own slot type."
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "default": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "slot_type"
            ]
          },
          "minItems": 1
        },
        "worn_size": {
          "$ref": "common.schema.json#/$defs/size",
          "description": "While it is equipped, its wearer counts as this size class (doors, rooms, the size check), e.g. a powered suit or a mount. The largest counts."
        },
        "equip_requires": {
          "$ref": "common.schema.json#/$defs/condition",
          "description": "Who can equip it, e.g. a skill level. Checked with 'self' as the character."
        },
        "mod_slots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0,
          "description": "How many modifications it can take. Modifications are permanent."
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "size",
        "slot_type"
      ]
    },
    "material": {
      "type": "object",
      "description": "Raw or salvaged stuff: scrap, ore, exotic matter. Used for trade and, later, crafting.",
      "properties": {
