{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strings.schema.json",
  "title": "Strings (strings.json)",
  "description": "All text the engine prints comes from here, so the engine names no content and writes no prose. Also holds reusable texts referred to as '@id'.",
  "x-schema-version": 4,
  "$ref": "#/$defs/strings_file",
  "$defs": {
    "strings_file": {
      "type": "object",
      "description": "A strings file.",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "Path to this file's schema, for editors. Ignored by the engine."
        },
        "engine": {
          "$ref": "#/$defs/engine"
        },
        "entries": {
          "type": "array",
          "description": "Reusable texts.",
          "items": {
            "$ref": "#/$defs/string"
          }
        }
      },
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "description": "The engine's messages in the pack's words. Placeholders in braces, e.g. 'You enter {location}.', are filled in by the engine; each message may use only its listed placeholders. A missing message is shown as its key.",
      "properties": {
        "enter_location": {
          "type": "string",
          "minLength": 1,
          "description": "Arriving somewhere. Placeholders: {location}, {character}.",
          "x-placeholders": [
            "location",
            "character"
          ]
        },
        "exit_blocked": {
          "type": "string",
          "minLength": 1,
          "description": "An exit can't be used and gives no hint of its own. Placeholders: {object}, {state}.",
          "x-placeholders": [
            "object",
            "state"
          ]
        },
        "needs": {
          "type": "string",
          "minLength": 1,
          "description": "Default hint for an unmet requirement; 'needs' is a list of tag names joined with list_or. Placeholders: {needs}.",
          "x-placeholders": [
            "needs"
          ]
        },
        "list_or": {
          "type": "string",
          "minLength": 1,
          "description": "Joins the last two entries of a list of alternatives, e.g. ' or '. No placeholders.",
          "x-placeholders": []
        },
        "list_and": {
          "type": "string",
          "minLength": 1,
          "description": "Joins the last two entries of a list, e.g. ' and '. No placeholders.",
          "x-placeholders": []
        },
        "nothing_here": {
          "type": "string",
          "minLength": 1,
          "description": "Acting on an empty tile. No placeholders.",
          "x-placeholders": []
        },
        "unknown_command": {
          "type": "string",
          "minLength": 1,
          "description": "A typed command isn't recognised. No placeholders.",
          "x-placeholders": []
        },
        "items_found": {
          "type": "string",
          "minLength": 1,
          "description": "Items from searching or loot. Placeholders: {items}.",
          "x-placeholders": [
            "items"
          ]
        },
        "items_gained": {
          "type": "string",
          "minLength": 1,
          "description": "Items received. Placeholders: {items}.",
          "x-placeholders": [
            "items"
          ]
        },
        "items_lost": {
          "type": "string",
          "minLength": 1,
          "description": "Items taken or used up. Placeholders: {items}.",
          "x-placeholders": [
            "items"
          ]
        },
        "item_broken": {
          "type": "string",
          "minLength": 1,
          "description": "An item's condition reaches 0. Placeholders: {item}.",
          "x-placeholders": [
            "item"
          ]
        },
        "cargo_full": {
          "type": "string",
          "minLength": 1,
          "description": "No cargo space left for an item. Placeholders: {item}.",
          "x-placeholders": [
            "item"
          ]
        },
        "cannot_fit": {
          "type": "string",
          "minLength": 1,
          "description": "A thing doesn't fit in, through or onto something. Placeholders: {thing}, {container}.",
          "x-placeholders": [
            "thing",
            "container"
          ]
        },
        "skill_up": {
          "type": "string",
          "minLength": 1,
          "description": "A skill level is reached. Placeholders: {skill}, {level}, {text}.",
          "x-placeholders": [
            "skill",
            "level",
            "text"
          ]
        },
        "party_join": {
          "type": "string",
          "minLength": 1,
          "description": "Someone joins a party. Placeholders: {character}, {leader}.",
          "x-placeholders": [
            "character",
            "leader"
          ]
        },
        "party_leave": {
          "type": "string",
          "minLength": 1,
          "description": "Someone leaves a party. Placeholders: {character}.",
          "x-placeholders": [
            "character"
          ]
        },
        "encounter_start": {
          "type": "string",
          "minLength": 1,
          "description": "An encounter begins. Placeholders: {encounter}.",
          "x-placeholders": [
            "encounter"
          ]
        },
        "encounter_won": {
          "type": "string",
          "minLength": 1,
          "description": "The player's side wins. Placeholders: {encounter}.",
          "x-placeholders": [
            "encounter"
          ]
        },
        "encounter_lost": {
          "type": "string",
          "minLength": 1,
          "description": "The player's side loses. Placeholders: {encounter}.",
          "x-placeholders": [
            "encounter"
          ]
        },
        "encounter_escaped": {
          "type": "string",
          "minLength": 1,
          "description": "The player's side gets away. Placeholders: {encounter}.",
          "x-placeholders": [
            "encounter"
          ]
        },
        "character_down": {
          "type": "string",
          "minLength": 1,
          "description": "A character is defeated. Placeholders: {character}.",
          "x-placeholders": [
            "character"
          ]
        },
        "pool_full": {
          "type": "string",
          "minLength": 1,
          "description": "A filling pool (heat, fatigue) reaches its maximum. Placeholders: {character}, {stat}.",
          "x-placeholders": [
            "character",
            "stat"
          ]
        },
        "status_applied": {
          "type": "string",
          "minLength": 1,
          "description": "A status takes hold. Placeholders: {character}, {status}.",
          "x-placeholders": [
            "character",
            "status"
          ]
        },
        "status_ended": {
          "type": "string",
          "minLength": 1,
          "description": "A status wears off. Placeholders: {character}, {status}.",
          "x-placeholders": [
            "character",
            "status"
          ]
        },
        "day_start": {
          "type": "string",
          "minLength": 1,
          "description": "A new day begins. Placeholders: {day}.",
          "x-placeholders": [
            "day"
          ]
        },
        "phase_start": {
          "type": "string",
          "minLength": 1,
          "description": "A new part of the day begins. Placeholders: {phase}, {day}.",
          "x-placeholders": [
            "phase",
            "day"
          ]
        },
        "already_used": {
          "type": "string",
          "minLength": 1,
          "description": "Why an interaction that can be used once (or once a day) is unavailable. No placeholders.",
          "x-placeholders": []
        },
        "unavailable": {
          "type": "string",
          "minLength": 1,
          "description": "Why an option is unavailable when it has no hint of its own. No placeholders.",
          "x-placeholders": []
        },
        "game_saved": {
          "type": "string",
          "minLength": 1,
          "description": "The game was saved. No placeholders.",
          "x-placeholders": []
        },
        "workshop_needed": {
          "type": "string",
          "minLength": 1,
          "description": "Equipping or taking off gear in this slot type needs a workshop offering 'equip'. No placeholders.",
          "x-placeholders": []
        },
        "no_free_slot": {
          "type": "string",
          "minLength": 1,
          "description": "No free slot for the item. Placeholders: {item}.",
          "x-placeholders": [
            "item"
          ]
        },
        "cannot_use": {
          "type": "string",
          "minLength": 1,
          "description": "The character doesn't meet the item's equip requirement. Placeholders: {item}.",
          "x-placeholders": [
            "item"
          ]
        },
        "over_budget": {
          "type": "string",
          "minLength": 1,
          "description": "The loadout would need more of a budget than it has. Placeholders: {stat}, {need}, {have}.",
          "x-placeholders": [
            "stat",
            "need",
            "have"
          ]
        },
        "empty_slots_first": {
          "type": "string",
          "minLength": 1,
          "description": "Gear comes off only after what is in its slots. Placeholders: {item}.",
          "x-placeholders": [
            "item"
          ]
        },
        "storage_full": {
          "type": "string",
          "minLength": 1,
          "description": "No room left in the storage. Placeholders: {container}.",
          "x-placeholders": [
            "container"
          ]
        },
        "item_equipped": {
          "type": "string",
          "minLength": 1,
          "description": "An item was equipped. Placeholders: {item}.",
          "x-placeholders": [
            "item"
          ]
        },
        "item_removed": {
          "type": "string",
          "minLength": 1,
          "description": "An item was removed. Placeholders: {item}.",
          "x-placeholders": [
            "item"
          ]
        },
        "item_stored": {
          "type": "string",
          "minLength": 1,
          "description": "An item was put into storage. Placeholders: {item}, {container}.",
          "x-placeholders": [
            "item",
            "container"
          ]
        },
        "item_taken": {
          "type": "string",
          "minLength": 1,
          "description": "An item was taken from storage. Placeholders: {item}, {container}.",
          "x-placeholders": [
            "item",
            "container"
          ]
        },
        "uses_action": {
          "type": "string",
          "minLength": 1,
          "description": "Someone uses an action in an encounter. Placeholders: {character}, {action}.",
          "x-placeholders": [
            "character",
            "action"
          ]
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "description": "What an enemy is about to do, shown next to it. Placeholders: {action}, {target}.",
          "x-placeholders": [
            "action",
            "target"
          ]
        },
        "on_cooldown": {
          "type": "string",
          "minLength": 1,
          "description": "Why an action can't be used: still cooling down. Placeholders: {rounds}.",
          "x-placeholders": [
            "rounds"
          ]
        },
        "no_charges": {
          "type": "string",
          "minLength": 1,
          "description": "Why an action can't be used: no uses left this encounter. No placeholders.",
          "x-placeholders": []
        },
        "cannot_pay": {
          "type": "string",
          "minLength": 1,
          "description": "Why an action can't be used: a pool can't pay its cost. Placeholders: {stat}.",
          "x-placeholders": [
            "stat"
          ]
        },
        "needs_item": {
          "type": "string",
          "minLength": 1,
          "description": "Why an action can't be used: an item it uses up is missing. Placeholders: {item}.",
          "x-placeholders": [
            "item"
          ]
        },
        "skips_turn": {
          "type": "string",
          "minLength": 1,
          "description": "Someone loses their action (a full pool, stunned). Placeholders: {character}.",
          "x-placeholders": [
            "character"
          ]
        },
        "fled": {
          "type": "string",
          "minLength": 1,
          "description": "Someone flees the encounter. Placeholders: {character}.",
          "x-placeholders": [
            "character"
          ]
        },
        "needs_service": {
          "type": "string",
          "minLength": 1,
          "description": "No workshop within reach offers this. No placeholders.",
          "x-placeholders": []
        },
        "too_advanced": {
          "type": "string",
          "minLength": 1,
          "description": "The workshops within reach can't work on an item of this grade. Placeholders: {item}.",
          "x-placeholders": [
            "item"
          ]
        },
        "needs_materials": {
          "type": "string",
          "minLength": 1,
          "description": "Materials are missing; 'items' lists them with counts. Placeholders: {items}.",
          "x-placeholders": [
            "items"
          ]
        },
        "no_mod_slot": {
          "type": "string",
          "minLength": 1,
          "description": "The item has no free mod slot. Placeholders: {item}.",
          "x-placeholders": [
            "item"
          ]
        },
        "already_modified": {
          "type": "string",
          "minLength": 1,
          "description": "The item already has this modification. Placeholders: {item}, {modification}.",
          "x-placeholders": [
            "item",
            "modification"
          ]
        },
        "not_damaged": {
          "type": "string",
          "minLength": 1,
          "description": "The item doesn't need repair. Placeholders: {item}.",
          "x-placeholders": [
            "item"
          ]
        },
        "item_dismantled": {
          "type": "string",
          "minLength": 1,
          "description": "An item was taken apart; 'items' lists what it gave. Placeholders: {item}, {items}.",
          "x-placeholders": [
            "item",
            "items"
          ]
        },
        "design_learned": {
          "type": "string",
          "minLength": 1,
          "description": "Dismantling taught a design. Placeholders: {item}.",
          "x-placeholders": [
            "item"
          ]
        },
        "design_not_learned": {
          "type": "string",
          "minLength": 1,
          "description": "Dismantling didn't teach the design (not skilled enough). Placeholders: {item}.",
          "x-placeholders": [
            "item"
          ]
        },
        "item_made": {
          "type": "string",
          "minLength": 1,
          "description": "An item was made. Placeholders: {item}.",
          "x-placeholders": [
            "item"
          ]
        },
        "item_modified": {
          "type": "string",
          "minLength": 1,
          "description": "A modification was applied. Placeholders: {item}, {modification}.",
          "x-placeholders": [
            "item",
            "modification"
          ]
        },
        "item_repaired": {
          "type": "string",
          "minLength": 1,
          "description": "An item was repaired. Placeholders: {item}.",
          "x-placeholders": [
            "item"
          ]
        },
        "item_used": {
          "type": "string",
          "minLength": 1,
          "description": "An item's interaction was used from the pack. Placeholders: {item}.",
          "x-placeholders": [
            "item"
          ]
        },
        "action_on": {
          "type": "string",
          "minLength": 1,
          "description": "Someone uses an action on someone else in an encounter. Placeholders: {character}, {action}, {target}.",
          "x-placeholders": [
            "character",
            "action",
            "target"
          ]
        },
        "damage_taken": {
          "type": "string",
          "minLength": 1,
          "description": "A fighter takes damage in an encounter (after resistance). Placeholders: {character}, {amount}.",
          "x-placeholders": [
            "character",
            "amount"
          ]
        },
        "damage_blocked": {
          "type": "string",
          "minLength": 1,
          "description": "A hit does no damage: resistance stopped all of it. Placeholders: {character}.",
          "x-placeholders": [
            "character"
          ]
        }
      },
      "additionalProperties": false
    },
    "string": {
      "type": "object",
      "description": "Reusable text. Any text field that is exactly '@' plus this id shows it.",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "text": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "notes": {
          "$ref": "common.schema.json#/$defs/notes"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ]
    }
  }
}
