{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pack.schema.json",
  "title": "Pack manifest (pack.json)",
  "description": "The entry point of a content pack: what it is, which schema it was written for, where the game starts, and which data files to load. The engine loads only the files listed here.",
  "x-schema-version": 4,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "schema_version",
    "start",
    "files"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path to this file's schema, for editors. Ignored by the engine."
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/label"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "The pack's own version (major.minor.patch)."
    },
    "schema_version": {
      "const": 4,
      "description": "Schema version the pack was written for. The engine refuses packs written for another version."
    },
    "purpose": {
      "enum": [
        "game",
        "test"
      ],
      "default": "game",
      "description": "'test' packs hold small generic content for engine development and automated tests."
    },
    "description": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "help": {
      "$ref": "common.schema.json#/$defs/text",
      "description": "The game's own part of the help screen: its premise and a few tips, in plain words. Shown under the interface's own help. Optional."
    },
    "authors": {
      "type": "array",
      "description": "Credits.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ui": {
      "$ref": "common.schema.json#/$defs/id",
      "default": "default",
      "description": "The UI pack to play with, by id: packs/ui/<id>. Players can choose another."
    },
    "start": {
      "type": "object",
      "description": "Where and how a new game begins.",
      "properties": {
        "location": {
          "$ref": "common.schema.json#/$defs/id",
          "x-ref": "location"
        },
        "entry": {
          "$ref": "common.schema.json#/$defs/id",
          "x-ref": "placement",
          "description": "Placed object to start at. Defaults to the location's entry point."
        },
        "player": {
          "$ref": "common.schema.json#/$defs/id",
          "x-ref": "character",
          "description": "The character the player controls at the start. Character creation, once designed, adjusts this template."
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "phase": {
          "$ref": "common.schema.json#/$defs/id",
          "x-ref": "phase",
          "description": "Defaults to the first phase in the vocabulary."
        }
      },
      "additionalProperties": false,
      "required": [
        "location",
        "player"
      ]
    },
    "settings": {
      "type": "object",
      "description": "Engine rules the pack may tune. Every field has a default.",
      "properties": {
        "skill_max_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 5
        },
        "relation_min": {
          "type": "integer",
          "default": -100
        },
        "relation_max": {
          "type": "integer",
          "default": 100
        },
        "relation_default": {
          "type": "integer",
          "default": 0,
          "description": "How characters regard each other before anything has happened."
        },
        "events_per_trigger": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "At most this many events fire at one trigger moment (a day start, a turn, an arrival), picked by weight. 0 means no limit."
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "description": "Data files to load, grouped by kind. Files of one kind are merged; ids must be unique across them.",
      "properties": {
        "vocab": {
          "$ref": "#/$defs/file_list",
          "description": "Files holding vocab."
        },
        "regions": {
          "$ref": "#/$defs/file_list",
          "description": "Files holding regions."
        },
        "locations": {
          "$ref": "#/$defs/file_list",
          "description": "Files holding locations."
        },
        "zones": {
          "$ref": "#/$defs/file_list",
          "description": "Files holding zones."
        },
        "objects": {
          "$ref": "#/$defs/file_list",
          "description": "Files holding objects."
        },
        "items": {
          "$ref": "#/$defs/file_list",
          "description": "Files holding items."
        },
        "actions": {
          "$ref": "#/$defs/file_list",
          "description": "Files holding actions."
        },
        "skills": {
          "$ref": "#/$defs/file_list",
          "description": "Files holding skills."
        },
        "characters": {
          "$ref": "#/$defs/file_list",
          "description": "Files holding characters."
        },
        "encounters": {
          "$ref": "#/$defs/file_list",
          "description": "Files holding encounters."
        },
        "loot_tables": {
          "$ref": "#/$defs/file_list",
          "description": "Files holding loot tables."
        },
        "events": {
          "$ref": "#/$defs/file_list",
          "description": "Files holding events."
        },
        "strings": {
          "$ref": "#/$defs/file_list",
          "description": "Files holding strings."
        },
        "modifications": {
          "$ref": "#/$defs/file_list",
          "description": "Files holding modifications."
        },
        "palette": {
          "$ref": "#/$defs/file_list",
          "description": "Files holding the palette: the pack's named colours. Every colour in the pack is a name from it."
        },
        "starts": {
          "$ref": "#/$defs/file_list",
          "description": "Files holding starts: other ways to begin a game, for playtesting."
        },
        "art": {
          "$ref": "#/$defs/file_list",
          "description": "Files holding art: pictures in pixels."
        }
      },
      "additionalProperties": false,
      "required": [
        "vocab"
      ]
    },
    "extends": {
      "type": "array",
      "description": "Packs this one adds to or overrides (mods).",
      "items": {
        "$ref": "common.schema.json#/$defs/id",
        "x-ref": "pack"
      },
      "x-status": "reserved"
    },
    "notes": {
      "$ref": "common.schema.json#/$defs/notes"
    }
  },
  "$defs": {
    "file_list": {
      "type": "array",
      "description": "Files of one kind, relative to the pack folder.",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_\\-/]+\\.json$",
        "description": "Path relative to the pack folder. No absolute paths or '..'."
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
