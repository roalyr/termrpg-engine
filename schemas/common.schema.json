{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Common grammar",
  "description": "Shared building blocks for every pack file: ids and references, text, amounts, conditions, effects and interactions. The lists of checks (check_*) and operations (op_*) are the engine's feature list. Parity rule: nothing here is player-only; any character may be controlled by the player or by the AI. Definitions marked x-status 'reserved' are planned but not implemented by the engine yet.",
  "x-schema-version": 2,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 48,
      "description": "Identifier: lower_snake_case, unique within its kind. Properties carrying 'x-ref' must name an existing id of that kind; the pack validator checks this."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "description": "A short name shown in lists and menus. Must fit a 40-column screen."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "description": "Player-facing text. Text that is exactly '@' plus an id uses that entry from the pack's strings file."
    },
    "glyph": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2,
      "description": "One character drawn on the map. No emoji."
    },
    "notes": {
      "type": "string",
      "description": "Author notes. Ignored by the engine."
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id",
        "x-ref": "tag"
      },
      "description": "Tags declared in the pack's vocabulary."
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9,
      "x-ref": "size",
      "description": "Size class of anything (item, object, character, suit frame, vessel), smallest 0. A shorthand for volume. Things that hold or let others through also have 'holds_size': the largest class that fits in, through or onto them. The pack names each class."
    },
    "duration": {
      "type": "integer",
      "minimum": 1,
      "description": "Length in turns (in encounters: rounds)."
    },
    "amount": {
      "description": "A fixed number, a range rolled from the game seed (integer bounds roll integers), or a value scaled from a stat or skill.",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "description": "Seeded roll between min and max, inclusive.",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ]
        },
        {
          "type": "object",
          "description": "stat (or skill level) of the subject, times 'times', plus 'plus', rounded down. E.g. damage that grows with a module's cutting stat.",
          "properties": {
            "stat": {
              "$ref": "#/$defs/id",
              "x-ref": "stat"
            },
            "skill": {
              "$ref": "#/$defs/id",
              "x-ref": "skill"
            },
            "subject": {
              "$ref": "#/$defs/subject",
              "default": "self"
            },
            "times": {
              "type": "number",
              "default": 1
            },
            "plus": {
              "type": "number",
              "default": 0
            }
          },
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "stat"
              ]
            },
            {
              "required": [
                "skill"
              ]
            }
          ]
        }
      ]
    },
    "subject": {
      "default": "self",
      "description": "Who or what a check or effect applies to. 'self' is whoever acts (the player when the player interacts, an NPC when an NPC acts), 'target' is what the action is aimed at, 'party' is the acting character and everyone travelling with them. Any specific character can be named, and inside events a cast role. Player-NPC parity: every check and effect works the same for any character, whether the player or the AI controls it.",
      "oneOf": [
        {
          "enum": [
            "self",
            "target",
            "player",
            "party"
          ]
        },
        {
          "type": "object",
          "description": "A specific character.",
          "properties": {
            "character": {
              "$ref": "#/$defs/id",
              "x-ref": "character"
            }
          },
          "additionalProperties": false,
          "required": [
            "character"
          ]
        },
        {
          "type": "object",
          "description": "A role from the running event's cast.",
          "properties": {
            "role": {
              "$ref": "#/$defs/id"
            }
          },
          "additionalProperties": false,
          "required": [
            "role"
          ]
        }
      ]
    },
    "object_ref": {
      "description": "A placed object: 'this' (the object whose interaction or template is running) or a placement id. Placement ids are unique across the pack; 'this' is never read as one.",
      "anyOf": [
        {
          "const": "this"
        },
        {
          "$ref": "#/$defs/id",
          "x-ref": "placement"
        }
      ]
    },
    "item_pick": {
      "description": "Which of the subject's items an effect or check means: a specific item, any item with a tag, whatever is fitted in a slot type, or the item that satisfied the current interaction's requirement ('used').",
      "oneOf": [
        {
          "type": "object",
          "description": "A specific item.",
          "properties": {
            "item": {
              "$ref": "#/$defs/id",
              "x-ref": "item"
            }
          },
          "additionalProperties": false,
          "required": [
            "item"
          ]
        },
        {
          "type": "object",
          "description": "The first carried or fitted item with this tag.",
          "properties": {
            "tag": {
              "$ref": "#/$defs/id",
              "x-ref": "tag"
            }
          },
          "additionalProperties": false,
          "required": [
            "tag"
          ]
        },
        {
          "type": "object",
          "description": "The item fitted in a slot of this type.",
          "properties": {
            "slot_type": {
              "$ref": "#/$defs/id",
              "x-ref": "slot_type"
            }
          },
          "additionalProperties": false,
          "required": [
            "slot_type"
          ]
        },
        {
          "type": "object",
          "description": "The item that satisfied the requirement of the interaction or action being performed.",
          "properties": {
            "used": {
              "const": true
            }
          },
          "additionalProperties": false,
          "required": [
            "used"
          ]
        }
      ]
    },
    "agent": {
      "description": "A character or a faction that can hold a view of others: a subject word, a named character, or a faction.",
      "oneOf": [
        {
          "enum": [
            "self",
            "target",
            "player"
          ]
        },
        {
          "type": "object",
          "description": "A specific character.",
          "properties": {
            "character": {
              "$ref": "#/$defs/id",
              "x-ref": "character"
            }
          },
          "additionalProperties": false,
          "required": [
            "character"
          ]
        },
        {
          "type": "object",
          "description": "A faction.",
          "properties": {
            "faction": {
              "$ref": "#/$defs/id",
              "x-ref": "faction"
            }
          },
          "additionalProperties": false,
          "required": [
            "faction"
          ]
        },
        {
          "type": "object",
          "description": "A role from the running event's cast.",
          "properties": {
            "role": {
              "$ref": "#/$defs/id"
            }
          },
          "additionalProperties": false,
          "required": [
            "role"
          ]
        }
      ]
    },
    "message_kind": {
      "enum": [
        "plain",
        "gain",
        "danger",
        "quiet"
      ],
      "default": "plain",
      "description": "How the message is styled and sorted: gains in bold, danger in the warning colour, quiet dimmed."
    },
    "condition": {
      "description": "Something that can be true or false. Combine with all / any / not; leaves use 'check'.",
      "x-discriminator": "check",
      "oneOf": [
        {
          "type": "object",
          "description": "True when every condition is true.",
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "all"
          ]
        },
        {
          "type": "object",
          "description": "True when at least one condition is true.",
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "any"
          ]
        },
        {
          "type": "object",
          "description": "True when the condition is false.",
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          },
          "additionalProperties": false,
          "required": [
            "not"
          ]
        },
        {
          "$ref": "#/$defs/check_has_tag"
        },
        {
          "$ref": "#/$defs/check_has_item"
        },
        {
          "$ref": "#/$defs/check_skill"
        },
        {
          "$ref": "#/$defs/check_stat"
        },
        {
          "$ref": "#/$defs/check_item_condition"
        },
        {
          "$ref": "#/$defs/check_knows_design"
        },
        {
          "$ref": "#/$defs/check_status"
        },
        {
          "$ref": "#/$defs/check_flag"
        },
        {
          "$ref": "#/$defs/check_location"
        },
        {
          "$ref": "#/$defs/check_region"
        },
        {
          "$ref": "#/$defs/check_visited"
        },
        {
          "$ref": "#/$defs/check_object_state"
        },
        {
          "$ref": "#/$defs/check_size"
        },
        {
          "$ref": "#/$defs/check_fits"
        },
        {
          "$ref": "#/$defs/check_in_party"
        },
        {
          "$ref": "#/$defs/check_relation"
        },
        {
          "$ref": "#/$defs/check_rank"
        },
        {
          "$ref": "#/$defs/check_time"
        },
        {
          "$ref": "#/$defs/check_chance"
        }
      ]
    },
    "effect": {
      "description": "One thing that happens. The 'op' decides which.",
      "x-discriminator": "op",
      "oneOf": [
        {
          "$ref": "#/$defs/op_message"
        },
        {
          "$ref": "#/$defs/op_give_item"
        },
        {
          "$ref": "#/$defs/op_take_item"
        },
        {
          "$ref": "#/$defs/op_wear"
        },
        {
          "$ref": "#/$defs/op_modify_item"
        },
        {
          "$ref": "#/$defs/op_learn_design"
        },
        {
          "$ref": "#/$defs/op_roll_loot"
        },
        {
          "$ref": "#/$defs/op_damage"
        },
        {
          "$ref": "#/$defs/op_restore"
        },
        {
          "$ref": "#/$defs/op_modify_stat"
        },
        {
          "$ref": "#/$defs/op_apply_status"
        },
        {
          "$ref": "#/$defs/op_remove_status"
        },
        {
          "$ref": "#/$defs/op_set_flag"
        },
        {
          "$ref": "#/$defs/op_set_state"
        },
        {
          "$ref": "#/$defs/op_move_to"
        },
        {
          "$ref": "#/$defs/op_end_encounter"
        },
        {
          "$ref": "#/$defs/op_start_encounter"
        },
        {
          "$ref": "#/$defs/op_grant_xp"
        },
        {
          "$ref": "#/$defs/op_join_party"
        },
        {
          "$ref": "#/$defs/op_leave_party"
        },
        {
          "$ref": "#/$defs/op_change_relation"
        },
        {
          "$ref": "#/$defs/op_change_rank"
        },
        {
          "$ref": "#/$defs/op_unlock_slot"
        },
        {
          "$ref": "#/$defs/op_spend_time"
        },
        {
          "$ref": "#/$defs/op_trigger_event"
        },
        {
          "$ref": "#/$defs/op_if"
        },
        {
          "$ref": "#/$defs/op_choose"
        }
      ]
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      },
      "description": "Effects applied in order."
    },
    "interaction": {
      "type": "object",
      "description": "Something the player can do with an object or a character. Replaces fixed fixture effects: anything is 'when this holds, doing this has these effects'.",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z]$",
          "description": "Suggested single key in the proximity menu. The engine may reassign it on conflict."
        },
        "shown_if": {
          "$ref": "#/$defs/condition",
          "description": "Hide the interaction entirely unless this holds."
        },
        "requires": {
          "$ref": "#/$defs/condition",
          "description": "Shown but unavailable unless this holds."
        },
        "hint": {
          "$ref": "#/$defs/text",
          "description": "Shown when 'requires' fails, e.g. 'Needs a cutter or a strong frame.'"
        },
        "time": {
          "type": "integer",
          "minimum": 0,
          "default": 1,
          "description": "Turns it takes."
        },
        "repeat": {
          "enum": [
            "always",
            "once",
            "daily"
          ],
          "default": "always",
          "description": "'once' disables it after use; 'daily' re-enables it each new day."
        },
        "effects": {
          "$ref": "#/$defs/effects"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "effects"
      ]
    },
    "check_has_tag": {
      "type": "object",
      "description": "The subject has this tag from any of its sources (fitted gear, carried items, skills, implants, party members).",
      "properties": {
        "check": {
          "const": "has_tag"
        },
        "tag": {
          "$ref": "#/$defs/id",
          "x-ref": "tag"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "source": {
          "enum": [
            "any",
            "fitted",
            "carried",
            "body",
            "party"
          ],
          "default": "any",
          "description": "Limit where the tag may come from. 'fitted' = suit gear and modules, 'body' = implants and skills, 'party' = companions."
        }
      },
      "additionalProperties": false,
      "required": [
        "check",
        "tag"
      ]
    },
    "check_has_item": {
      "type": "object",
      "description": "The subject holds at least this many of the item: carried by default, or fitted (worn frame, modules, implants), or either.",
      "properties": {
        "check": {
          "const": "has_item"
        },
        "item": {
          "$ref": "#/$defs/id",
          "x-ref": "item"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "source": {
          "enum": [
            "carried",
            "fitted",
            "any"
          ],
          "default": "carried",
          "description": "Where the items may be. 'carried' (the default) matches what take_item can take; 'fitted' = the worn frame, modules and implants."
        },
        "subject": {
          "$ref": "#/$defs/subject"
        }
      },
      "additionalProperties": false,
      "required": [
        "check",
        "item"
      ]
    },
    "check_skill": {
      "type": "object",
      "description": "The subject's skill is at least this level.",
      "properties": {
        "check": {
          "const": "skill"
        },
        "skill": {
          "$ref": "#/$defs/id",
          "x-ref": "skill"
        },
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "subject": {
          "$ref": "#/$defs/subject"
        }
      },
      "additionalProperties": false,
      "required": [
        "check",
        "skill",
        "min"
      ]
    },
    "check_stat": {
      "type": "object",
      "description": "The subject's current stat value is within bounds (inclusive).",
      "properties": {
        "check": {
          "const": "stat"
        },
        "stat": {
          "$ref": "#/$defs/id",
          "x-ref": "stat"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "required": [
        "check",
        "stat"
      ],
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        }
      ]
    },
    "check_item_condition": {
      "type": "object",
      "description": "A picked item's condition is within bounds. Items without a condition always pass.",
      "properties": {
        "check": {
          "const": "item_condition"
        },
        "pick": {
          "$ref": "#/$defs/item_pick"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "required": [
        "check",
        "pick"
      ],
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        }
      ]
    },
    "check_knows_design": {
      "type": "object",
      "description": "The subject knows how to fabricate this item.",
      "properties": {
        "check": {
          "const": "knows_design"
        },
        "item": {
          "$ref": "#/$defs/id",
          "x-ref": "item"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        }
      },
      "additionalProperties": false,
      "required": [
        "check",
        "item"
      ]
    },
    "check_status": {
      "type": "object",
      "description": "The subject currently has this status.",
      "properties": {
        "check": {
          "const": "status"
        },
        "status": {
          "$ref": "#/$defs/id",
          "x-ref": "status"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        }
      },
      "additionalProperties": false,
      "required": [
        "check",
        "status"
      ]
    },
    "check_flag": {
      "type": "object",
      "description": "A world flag's value is within bounds. Unset flags read as 0.",
      "properties": {
        "check": {
          "const": "flag"
        },
        "flag": {
          "$ref": "#/$defs/id",
          "x-ref": "flag"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "required": [
        "check",
        "flag"
      ],
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        }
      ]
    },
    "check_location": {
      "type": "object",
      "description": "The subject is in this location.",
      "properties": {
        "check": {
          "const": "location"
        },
        "location": {
          "$ref": "#/$defs/id",
          "x-ref": "location"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        }
      },
      "additionalProperties": false,
      "required": [
        "check",
        "location"
      ]
    },
    "check_region": {
      "type": "object",
      "description": "The subject is in this region.",
      "properties": {
        "check": {
          "const": "region"
        },
        "region": {
          "$ref": "#/$defs/id",
          "x-ref": "region"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        }
      },
      "additionalProperties": false,
      "required": [
        "check",
        "region"
      ]
    },
    "check_visited": {
      "type": "object",
      "description": "The subject has been to this location at least once.",
      "properties": {
        "check": {
          "const": "visited"
        },
        "location": {
          "$ref": "#/$defs/id",
          "x-ref": "location"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        }
      },
      "additionalProperties": false,
      "required": [
        "check",
        "location"
      ]
    },
    "check_object_state": {
      "type": "object",
      "description": "An object is in the given state.",
      "properties": {
        "check": {
          "const": "object_state"
        },
        "object": {
          "$ref": "#/$defs/object_ref"
        },
        "state": {
          "$ref": "#/$defs/id",
          "x-ref": "object_state"
        }
      },
      "additionalProperties": false,
      "required": [
        "check",
        "object",
        "state"
      ]
    },
    "check_size": {
      "type": "object",
      "description": "The subject's size class is within bounds (inclusive). A character's size is that of their current suit frame, or their body without one.",
      "properties": {
        "check": {
          "const": "size"
        },
        "min": {
          "$ref": "#/$defs/size"
        },
        "max": {
          "$ref": "#/$defs/size"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        }
      },
      "additionalProperties": false,
      "required": [
        "check"
      ],
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        }
      ]
    },
    "check_fits": {
      "type": "object",
      "description": "A thing fits into, through or onto a container: its size is at most the container's 'holds_size'. The thing is the subject, or an item; the container is an object, an item or a location.",
      "properties": {
        "check": {
          "const": "fits"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "item": {
          "$ref": "#/$defs/id",
          "x-ref": "item",
          "description": "Check this item instead of the subject."
        },
        "into_object": {
          "$ref": "#/$defs/object_ref"
        },
        "into_item": {
          "$ref": "#/$defs/id",
          "x-ref": "item"
        },
        "into_location": {
          "$ref": "#/$defs/id",
          "x-ref": "location"
        }
      },
      "additionalProperties": false,
      "required": [
        "check"
      ],
      "oneOf": [
        {
          "required": [
            "into_object"
          ]
        },
        {
          "required": [
            "into_item"
          ]
        },
        {
          "required": [
            "into_location"
          ]
        }
      ]
    },
    "check_in_party": {
      "type": "object",
      "description": "The subject travels in the leader's party.",
      "properties": {
        "check": {
          "const": "in_party"
        },
